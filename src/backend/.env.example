# Application Settings
APP_NAME=Smart Attendance System
APP_VERSION=0.1.0
DEBUG=True
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database (Note: Docker uses port 5433 to avoid conflicts with existing postgresql)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/attendance_db

# JWT Settings
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth (Note: Docker backend uses port 8001 to avoid conflicts with portainer)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8001/api/v1/auth/google/callback

# Google Calendar API
GOOGLE_CALENDAR_API_KEY=your-calendar-api-key

# Redis (Note: Docker uses port 6380 to avoid conflicts with clearml-redis)
REDIS_URL=redis://localhost:6380/0

# Notification Services
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SLACK_WEBHOOK_URL=your-slack-webhook-url

# CORS (Frontend runs on port 5173)
CORS_ORIGINS=http://localhost:5173
